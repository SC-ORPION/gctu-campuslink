datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  student
  admin
}

enum Status {
  ACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
}

enum GenderRule {
  MALE_ONLY
  FEMALE_ONLY
  MIXED
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  ALLOCATED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  BANK
  CASH
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  fullName   String   @map("full_name")
  studentId  String?  @unique @map("student_id")
  role       Role     @default(student)
  status     Status   @default(ACTIVE)
  gender     Gender?
  createdAt  DateTime @default(now()) @map("created_at")

  profile    StudentProfile?
  bookings   Booking[]

  @@map("users")
}

model StudentProfile {
  userId      String   @id @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String   @map("phone_number")
  gender      Gender
  department  String
  program     String
  faculty     String
  campus      String   @default("GCTU")

  @@map("student_profiles")
}

model Hostel {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  campus             String        @default("GCTU")
  locationArea       String        @map("location_name") // Mapped to existing canonical col
  distanceFromCampus String?       @map("distance_from_campus")
  genderRule         GenderRule    @default(MIXED) @map("gender_rule")
  bookingEnabled     Boolean       @default(true) @map("booking_enabled")
  allocationMode     String        @default("AUTO") @map("allocation_mode")
  coverImage         String?       @map("cover_image")
  createdAt          DateTime      @default(now()) @map("created_at")
  status             String        @default("OPEN")

  buildings          Building[]
  images             HostelImage[]
  bookings           Booking[]

  @@map("hostels")
}

model HostelImage {
  id           String   @id @default(uuid()) @db.Uuid
  hostelId     String   @map("hostel_id") @db.Uuid
  hostel       Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  mediumUrl    String?  @map("medium_url")
  orderIndex   Int      @default(0) @map("order_index")

  @@map("hostel_images")
}

model Building {
  id             String     @id @default(uuid()) @db.Uuid
  hostelId       String     @map("hostel_id") @db.Uuid
  hostel         Hostel     @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  name           String
  genderRule     GenderRule @default(MIXED) @map("gender_rule")
  bookingEnabled Boolean    @default(true) @map("booking_enabled")

  rooms          Room[]

  @@map("buildings")
}

model Room {
  id                String      @id @default(uuid()) @db.Uuid
  buildingId        String      @map("building_id") @db.Uuid
  building          Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  roomNumber        String      @map("room_number")
  capacity          Int
  currentOccupancy  Int         @default(0) @map("current_occupancy")
  genderRule        GenderRule  @map("gender_rule")
  bookingEnabled    Boolean     @default(true) @map("booking_enabled")
  price             Decimal     @default(0.00) @db.Decimal(10, 2)
  acAvailable       Boolean     @default(false) @map("ac_available")
  wifiAvailable     Boolean     @default(false) @map("wifi_available")
  kitchenAvailable  Boolean     @default(false) @map("kitchen_available")

  allocations       Allocation[]

  @@map("rooms")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @map("user_id") @db.Uuid // maps to public.users relation
  student         User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostelId        String        @map("hostel_id") @db.Uuid
  hostel          Hostel        @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  status          BookingStatus @default(PENDING_PAYMENT)
  lockedSelection Boolean       @default(false) @map("locked_selection")
  expiresAt       DateTime?     @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  paymentStatus   String        @default("PENDING") @map("payment_status")

  payments        Payment[]
  allocations     Allocation[]

  @@map("bookings")
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  bookingId  String        @map("booking_id") @db.Uuid
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  method     PaymentMethod @default(BANK)
  status     PaymentStatus @default(PENDING)
  reference  String?
  proofImage String?       @map("proof_image")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

model Allocation {
  id                String    @id @default(uuid()) @db.Uuid
  bookingId         String    @map("booking_id") @db.Uuid
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId            String    @map("room_id") @db.Uuid
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedByAdminId String?   @map("assigned_by_admin_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  revokedAt         DateTime? @map("revoked_at")

  @@map("allocations")
}

model BankSettings {
  id            String  @id @default(uuid()) @db.Uuid
  accountName   String  @map("account_name")
  accountNumber String  @map("account_number")
  bankName      String  @map("bank_name")
  enabled       Boolean @default(true)

  @@map("bank_settings")
}
